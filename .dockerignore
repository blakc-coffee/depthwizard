# Defense-in-depth: neither backend/Dockerfile nor worker/Dockerfile ever
# COPY these, but excluding them from the build context means a future
# careless `COPY . .` can't bake secrets or bloat into an image layer.

.git/
.gitignore
.gitattributes
.mcp.json

.env
.env.*
!.env.example

.claude/
CLAUDE.md
ONBOARDING.md
CLAUDE.local.md

__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store

# Neither image needs the frontend. Most ml/models/ weights are experiment
# artifacts the worker doesn't need either — except the production
# river-silt regressor, which it loads at runtime for every silt job.
# `ml/models/*`, not `ml/models/` — excluding the directory itself means
# Docker never looks inside it, so a negation below can't re-include anything.
frontend/
ml/models/*
!ml/models/river_silt_regressor_xgb_v1.json
node_modules/
