# Defense-in-depth: neither backend/Dockerfile nor worker/Dockerfile ever
# COPY these, but excluding them from the build context means a future
# careless `COPY . .` can't bake secrets or bloat into an image layer.

.git/
.gitignore
.gitattributes
.mcp.json

.env
.env.*
!.env.example

.claude/
CLAUDE.md
ONBOARDING.md
CLAUDE.local.md

__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store

# Neither image needs the frontend. Most ml/models/ weights are experiment
# artifacts the worker doesn't need either — except the production
# river-silt regressor, which it loads at runtime for every silt job.
# `ml/models/*`, not `ml/models/` — excluding the directory itself means
# Docker never looks inside it, so a negation below can't re-include anything.
frontend/
ml/models/*
!ml/models/river_silt_regressor_xgb_v1.json
node_modules/

# Real bug found 2026-09-17: none of these were dockerignored, even though
# they're already gitignored and are training-time-only (multi-GB raw
# imagery/caches, never read at inference). `COPY ml/ ml/` in worker/Dockerfile
# was copying all of it into every build — 3.5GB+ for river_silt_raw/ alone,
# enough to exhaust local disk mid-build. Neither image needs any of this.
ml/depth/samples/
ml/data/samples/
ml/data/cache/
ml/data/river_silt_raw/
/supplementary-data/
/data/
