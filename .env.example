# Supabase (PRD §6/§9.2)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database — Postgres is the durable source of truth for job state (PRD §2).
# Local docker-compose Postgres for dev; point at Supabase Postgres in prod.
DATABASE_URL=postgresql+psycopg://depthwizard:depthwizard@localhost:5432/depthwizard

# Redis — Celery broker ONLY, never job status (PRD §2).
# Local docker-compose Redis for dev; Upstash in prod.
REDIS_URL=redis://localhost:6379/0

# Storage — one private Supabase Storage bucket, prefixed by
# inputs/staging/outputs/compares (PRD §7). The prefixes themselves are
# fixed by the contract, not configurable.
STORAGE_BUCKET=depthwizard

# Upload limit (PRD §9.5)
MAX_UPLOAD_MB=50

# Signed URL expiry, minutes (PRD §7)
SIGNED_URL_EXPIRY_MINUTES=60

# CORS — comma-separated origins
CORS_ALLOW_ORIGINS=http://localhost:5173

# Hard per-task timeout, seconds (PRD §9.7 — every task carries one)
CELERY_TASK_TIME_LIMIT_SECONDS=600

# OpenTopography REST API — SRTM fetch, runtime dependency for every
# georeferenced job (PRD §7.0). Free key: opentopography.org/newUser
OPENTOPOGRAPHY_API_KEY=
