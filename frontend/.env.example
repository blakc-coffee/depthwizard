# DepthWizard Frontend Environment Variables (PRD §9.2)

# Supabase Auth Configuration (Client-safe public credentials)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API Base URL (FastAPI dev server)
VITE_API_BASE_URL=http://localhost:8000

# API Mode Toggle (true = mock fixtures, false = connect to real FastAPI backend)
VITE_USE_MOCK_API=false
